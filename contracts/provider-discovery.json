{
  "about": "What a mail address implies about where to connect: the provider table, the MX and SPF inference, Mozilla autoconfig parsing, and modified-UTF-7 folder names. Run by crates/torromail-control/tests/provider_discovery.rs and by the Swift contract suite. `expected` null means: nothing can be said, show the manual fields.",
  "app_password_fallback": [
    {
      "expected": {
        "kind": "app_password",
        "setup_url": "https://myaccount.google.com/apppasswords"
      },
      "input": "gmail.com"
    },
    {
      "expected": null,
      "input": "outlook.com"
    },
    {
      "expected": null,
      "input": "gmx.de"
    }
  ],
  "autoconfig": [
    {
      "expected": {
        "auth": {
          "kind": "password"
        },
        "imap_host": "imap.example.org",
        "imap_port": 143,
        "imap_security": "starttls",
        "provider": "IMAP/SMTP",
        "provider_label": "Example Mail",
        "smtp_host": "smtp.example.org",
        "smtp_port": 465,
        "smtp_security": "tls",
        "source": "ispdb"
      },
      "name": "the first imap server wins, pop is skipped, and the stated encryption is kept",
      "source": "ispdb",
      "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<clientConfig version=\"1.1\">\n  <emailProvider id=\"example.org\">\n    <domain>example.org</domain>\n    <displayName>Example Mail</displayName>\n    <displayShortName>Example</displayShortName>\n    <incomingServer type=\"pop3\">\n      <hostname>pop.example.org</hostname>\n      <port>995</port>\n      <socketType>SSL</socketType>\n      <authentication>password-cleartext</authentication>\n    </incomingServer>\n    <incomingServer type=\"imap\">\n      <hostname>imap.example.org</hostname>\n      <port>143</port>\n      <socketType>STARTTLS</socketType>\n      <username>%EMAILADDRESS%</username>\n      <authentication>password-cleartext</authentication>\n    </incomingServer>\n    <incomingServer type=\"imap\">\n      <hostname>imap2.example.org</hostname>\n      <port>993</port>\n      <socketType>SSL</socketType>\n    </incomingServer>\n    <outgoingServer type=\"smtp\">\n      <hostname>smtp.example.org</hostname>\n      <port>465</port>\n      <socketType>SSL</socketType>\n      <authentication>password-cleartext</authentication>\n    </outgoingServer>\n  </emailProvider>\n</clientConfig>"
    },
    {
      "expected": {
        "auth": {
          "issuer": "google",
          "kind": "oauth"
        },
        "imap_host": "imap.gmail.com",
        "imap_port": 993,
        "imap_security": "tls",
        "provider": "Gmail",
        "provider_label": "Google Mail",
        "smtp_host": "smtp.gmail.com",
        "smtp_port": 465,
        "smtp_security": "tls",
        "source": "autoconfig"
      },
      "name": "oauth2 anywhere in the list counts when the issuer is one we can talk to",
      "source": "autoconfig",
      "xml": "<clientConfig version=\"1.1\"><emailProvider id=\"googlemail.com\">\n<displayName>Google Mail</displayName>\n<incomingServer type=\"imap\"><hostname>imap.gmail.com</hostname><port>993</port><socketType>SSL</socketType>\n<authentication>OAuth2</authentication><authentication>password-cleartext</authentication></incomingServer>\n<outgoingServer type=\"smtp\"><hostname>smtp.gmail.com</hostname><port>465</port><socketType>SSL</socketType><authentication>OAuth2</authentication></outgoingServer>\n</emailProvider></clientConfig>"
    },
    {
      "expected": {
        "auth": {
          "kind": "password"
        },
        "imap_host": "mail.corp.example",
        "imap_port": 993,
        "imap_security": "tls",
        "provider": "IMAP/SMTP",
        "provider_label": "mail.corp.example",
        "smtp_host": "",
        "smtp_port": 587,
        "smtp_security": "starttls",
        "source": "autoconfig"
      },
      "name": "oauth2 from an issuer we have no registration with degrades to a password, plain is not honoured, and a missing smtp server stays empty",
      "source": "autoconfig",
      "xml": "<clientConfig version=\"1.1\"><emailProvider id=\"corp.example\">\n<incomingServer type=\"imap\"><hostname>mail.corp.example</hostname><port>993</port><socketType>plain</socketType>\n<authentication>password-cleartext</authentication><authentication>OAuth2</authentication></incomingServer>\n</emailProvider></clientConfig>"
    },
    {
      "expected": null,
      "name": "a document with no imap server says nothing",
      "source": "ispdb",
      "xml": "<clientConfig version=\"1.1\"><emailProvider id=\"old.example\"><displayName>Old</displayName>\n<incomingServer type=\"pop3\"><hostname>pop.old.example</hostname><port>995</port><socketType>SSL</socketType></incomingServer>\n</emailProvider></clientConfig>"
    },
    {
      "expected": null,
      "name": "something that is not xml says nothing",
      "source": "autoconfig",
      "xml": "<html><body>404"
    }
  ],
